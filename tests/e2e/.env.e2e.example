# Salin menjadi tests/e2e/.env.e2e (diabaikan Git), lalu isi.
#   cp tests/e2e/.env.e2e.example tests/e2e/.env.e2e

# Kosongkan agar Playwright menyalakan `npm run dev` sendiri di port E2E_PORT.
# Isi bila aplikasi sudah berjalan di alamat lain (mis. hasil `npm run start`).
E2E_BASE_URL=
E2E_PORT=3000

# Akun untuk tes yang butuh login. Untuk database lokal, pakai akun seed di
# PRD §20. Jangan pernah mengisi akun production di sini.
E2E_CUSTOMER_EMAIL=
E2E_CUSTOMER_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
