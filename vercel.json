{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci --ignore-scripts && npx prisma generate",
  "buildCommand": "npm run build",
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/cron/orders",
      "schedule": "0 17 * * *"
    }
  ]
}
