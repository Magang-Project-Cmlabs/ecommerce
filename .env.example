# ====================================================================
# TOKOKITA - TEMPLATE KONFIGURASI ENVIRONMENT
# ====================================================================
# 1. Salin berkas ini menjadi `.env`:
#      cp .env.example .env        (Git Bash)
#      copy .env.example .env      (Command Prompt / PowerShell)
# 2. Isi nilainya. `.env` TIDAK PERNAH di-commit (sudah diabaikan .gitignore).
# 3. Berkas ini hanya boleh berisi placeholder, bukan kredensial asli.
# Daftar variabel mengikuti PRD §12.
# ====================================================================

# Alamat publik situs. Dipakai untuk link di email (reset password) — wajib
# diisi di production; link tidak pernah dibentuk dari header Host.
APP_URL="http://localhost:3000"

# MySQL lokal Laragon: user root tanpa password, database `ecommerce`
DATABASE_URL="mysql://root:@localhost:3306/ecommerce"
# Hanya untuk MySQL terkelola yang mewajibkan TLS (mis. Aiven): isi sertifikat
# CA dari panel penyedia (PEM, boleh satu baris dengan \n). Kosongkan di lokal.
DATABASE_CA_CERT=""

# Minimal 32 karakter acak. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
CRON_SECRET="ganti-dengan-string-acak"

# Kota asal toko, dipakai syarat GoSend Instant (PRD §10.3)
STORE_CITY="Jakarta"

# --------------------------------------------------------------------
# Email (Nodemailer SMTP). Untuk development boleh memakai SMTP penangkap
# lokal seperti Mailpit (localhost:1025) agar email tidak benar-benar terkirim.
# --------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="TokoKita <no-reply@example.com>"

# --------------------------------------------------------------------
# Payment gateway Midtrans (lihat docs/runbooks/payment-midtrans.md)
# Sandbox: kunci berawalan "SB-Mid-server-". HANYA di server, jangan
# pernah diberi prefiks NEXT_PUBLIC_.
# --------------------------------------------------------------------
MIDTRANS_SERVER_KEY=""
MIDTRANS_IS_PRODUCTION="false"
# Tombol simulasi hanya untuk demo development; tidak berlaku di production.
PAYMENT_SIMULATION_ENABLED="false"

# --------------------------------------------------------------------
# Penyimpanan gambar: local (development) | s3 (production, Cloudflare R2)
# --------------------------------------------------------------------
STORAGE_DRIVER="local"
S3_ENDPOINT=""
# Cloudflare R2: auto. AWS S3/penyedia lain: region bucket (mis. us-east-1).
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_PUBLIC_URL=""

# Asisten AI (D18). Kunci gratis tanpa kartu: https://aistudio.google.com/apikey (akun Google).
# Kosong = tombol "Tanya AI" tidak tampil di produksi. Penyedia lain yang kompatibel OpenAI
# (mis. Groq https://api.groq.com/openai/v1) bisa dipakai lewat ASISTEN_BASE_URL + ASISTEN_MODEL.
ASISTEN_API_KEY=""
ASISTEN_BASE_URL=""
ASISTEN_MODEL=""
# Cadangan bila penyedia utama penuh/galat. Bawaan Groq (kunci gratis tanpa kartu:
# https://console.groq.com/keys), model bawaan openai/gpt-oss-120b lalu qwen/qwen3.8-27b (daftar model: https://console.groq.com/docs/models).
ASISTEN_CADANGAN_API_KEY=""
ASISTEN_CADANGAN_BASE_URL=""
ASISTEN_CADANGAN_MODEL=""
# Tombol darurat: isi 1 untuk mematikan asisten (tombol hilang, semua permintaan ditolak).
ASISTEN_NONAKTIF=""
