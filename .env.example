# ====================================================================
# TOKOKITA - TEMPLATE KONFIGURASI ENVIRONMENT
# ====================================================================
# 1. Salin berkas ini menjadi `.env`:
#      cp .env.example .env        (Git Bash)
#      copy .env.example .env      (Command Prompt / PowerShell)
# 2. Isi nilainya. `.env` TIDAK PERNAH di-commit (sudah diabaikan .gitignore).
# 3. Berkas ini hanya boleh berisi placeholder, bukan kredensial asli.
# Daftar variabel mengikuti PRD §12.
# ====================================================================

APP_URL="http://localhost:3000"

# MySQL lokal Laragon: user root tanpa password, database `ecommerce`
DATABASE_URL="mysql://root:@localhost:3306/ecommerce"

# Minimal 32 karakter acak. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
CRON_SECRET="ganti-dengan-string-acak"

# Kota asal toko, dipakai syarat GoSend Instant (PRD §10.3)
STORE_CITY="Jakarta"

# --------------------------------------------------------------------
# Email (Nodemailer SMTP). Untuk development boleh memakai SMTP penangkap
# lokal seperti Mailpit (localhost:1025) agar email tidak benar-benar terkirim.
# --------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="TokoKita <no-reply@example.com>"

# --------------------------------------------------------------------
# Penyimpanan gambar: local (development) | s3 (production, Cloudflare R2)
# --------------------------------------------------------------------
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_PUBLIC_URL=""
