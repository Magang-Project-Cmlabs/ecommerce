// Skema database TokoKita — sumber: PRD §9 (15 tabel) dan §10 (aturan bisnis).
//
// Konvensi (diputuskan di migration pertama, jangan dicampur):
// - Model PascalCase tunggal + field camelCase; nama tabel/kolom di MySQL
//   snake_case persis PRD lewat @@map / @map.
// - Uang = Int rupiah, berat = Int gram (CLAUDE.md aturan keras #2).
// - Riwayat tidak pernah dihapus: produk diarsipkan (isActive = false), akun
//   dianonimkan (deletedAt), relasi ke pesanan onDelete: Restrict.
// - Waktu disimpan UTC; tampilan WIB lewat src/lib/format.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// Infrastruktur D4: pembatas percobaan bersama untuk semua instance Vercel.
// HMAC aksi + IP, bukan alamat IP mentah. Jendela tetap 15 menit.
model AuthRateLimit {
  keyHash   String   @id @map("key_hash") @db.Char(64)
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at") @db.DateTime(3)

  @@index([expiresAt])
  @@map("auth_rate_limits")
}

// ---------------------------------------------------------------------------
// Enum — nilai persis PRD §9 / GLOSSARY.md

enum Role {
  customer
  admin
}

enum OrderStatus {
  pending
  confirmed
  packed
  shipped
  delivered
  cancelled
}

enum PaymentStatus {
  unpaid
  paid
  refunded
}

enum PaymentMethod {
  qris
  bank_bca
  bank_mandiri
  cod
}

enum ShippingMethod {
  jne_reg
  sicepat_reg
  gosend_instant
}

enum PromoType {
  PERCENT
  FIXED
}

// ---------------------------------------------------------------------------
// Pengguna (3 tabel)

model User {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(100)
  email        String    @unique @db.VarChar(191)
  phone        String?   @db.VarChar(20)
  passwordHash String    @map("password_hash") @db.VarChar(100)
  role         Role      @default(customer)
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  addresses           Address[]
  passwordResetTokens PasswordResetToken[]
  orders              Order[]
  reviews             Review[]
  wishlistItems       WishlistItem[]
  promoUsages         PromoUsage[]
  statusChanges       OrderStatusLog[]

  @@map("users")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64) // SHA-256 hex; token asli tidak disimpan
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Address {
  id         Int     @id @default(autoincrement())
  userId     Int     @map("user_id")
  label      String  @db.VarChar(50) // "Rumah", "Kantor"
  name       String  @db.VarChar(100) // nama penerima
  phone      String  @db.VarChar(20)
  street     String  @db.VarChar(255)
  city       String  @db.VarChar(100)
  district   String  @db.VarChar(100)
  province   String  @db.VarChar(100)
  postalCode String  @map("postal_code") @db.VarChar(10)
  isDefault  Boolean @default(false) @map("is_default")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Katalog (6 tabel)

model Category {
  id        Int     @id @default(autoincrement())
  name      String  @db.VarChar(100)
  slug      String  @unique @db.VarChar(120)
  image     String? @db.VarChar(255)
  parentId  Int?    @map("parent_id")
  sortOrder Int     @default(0) @map("sort_order")

  parent   Category?  @relation("SubKategori", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("SubKategori")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(200)
  slug           String   @unique @db.VarChar(220)
  description    String   @db.Text
  specs          Json // { "Bahan": "Katun", ... }
  price          Int // rupiah, sudah termasuk PPN 11% (PRD §10.2)
  compareAtPrice Int?     @map("compare_at_price")
  brand          String   @db.VarChar(100)
  categoryId     Int      @map("category_id")
  tags           Json // ["kaos", "katun"]
  weight         Int // gram
  rating         Decimal  @default(0) @db.Decimal(2, 1) // dihitung ulang tiap ulasan baru
  reviewCount    Int      @default(0) @map("review_count")
  soldCount      Int      @default(0) @map("sold_count")
  stock          Int      @default(0) // produk bervarian: total stok varian (PRD §10.1)
  isPreorder     Boolean  @default(false) @map("is_preorder")
  isFeatured     Boolean  @default(false) @map("is_featured")
  isActive       Boolean  @default(true) @map("is_active") // arsip = false, tidak dihapus
  variantLabel   String?  @map("variant_label") @db.VarChar(50) // "Ukuran", "Warna"
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  category      Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images        ProductImage[]
  variants      ProductVariant[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]

  @@index([categoryId])
  @@index([brand])
  @@index([price])
  @@map("products")
}

model ProductImage {
  id        Int    @id @default(autoincrement())
  productId Int    @map("product_id")
  url       String @db.VarChar(255)
  sortOrder Int    @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id        Int    @id @default(autoincrement())
  productId Int    @map("product_id")
  name      String @db.VarChar(50) // "M", "Merah"
  price     Int? // NULL = sama dengan harga produk
  weight    Int? // NULL = sama dengan berat produk
  stock     Int    @default(0)
  sortOrder Int    @default(0) @map("sort_order")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model Review {
  id          Int      @id @default(autoincrement())
  productId   Int      @map("product_id")
  userId      Int      @map("user_id")
  orderItemId Int      @unique @map("order_item_id") // satu ulasan per item pesanan
  rating      Int      @db.TinyInt // 1-5
  content     String   @db.Text
  images      Json // maks. 3 URL
  createdAt   DateTime @default(now()) @map("created_at")

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

model WishlistItem {
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
  @@map("wishlist_items")
}

// ---------------------------------------------------------------------------
// Transaksi (5 tabel)

model PromoCode {
  code         String    @id @db.VarChar(30)
  description  String    @db.VarChar(255)
  type         PromoType
  value        Int // persen (PERCENT) atau rupiah (FIXED)
  minSubtotal  Int       @default(0) @map("min_subtotal")
  maxDiscount  Int?      @map("max_discount")
  quota        Int? // NULL = tanpa batas
  usedCount    Int       @default(0) @map("used_count")
  perUserLimit Int       @default(1) @map("per_user_limit")
  startsAt     DateTime  @map("starts_at")
  expiresAt    DateTime  @map("expires_at")
  isActive     Boolean   @default(true) @map("is_active")

  usages PromoUsage[]

  @@map("promo_codes")
}

model PromoUsage {
  id        Int      @id @default(autoincrement())
  code      String   @db.VarChar(30)
  userId    Int      @map("user_id")
  orderId   Int      @unique @map("order_id") // maks. 1 promo per pesanan
  createdAt DateTime @default(now()) @map("created_at")

  promoCode PromoCode @relation(fields: [code], references: [code], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([code, userId]) // hitung pemakaian per pengguna
  @@index([userId])
  @@map("promo_usages")
}

model Order {
  id              Int            @id @default(autoincrement())
  orderNumber     String         @unique @map("order_number") @db.VarChar(20) // INV-202609-0001
  userId          Int            @map("user_id")
  subtotal        Int
  shippingCost    Int            @map("shipping_cost")
  discount        Int            @default(0)
  tax             Int            @default(0) // harga sudah termasuk PPN (PRD §10.2)
  grandTotal      Int            @map("grand_total")
  totalWeight     Int            @map("total_weight")
  status          OrderStatus    @default(pending)
  paymentMethod   PaymentMethod  @map("payment_method")
  paymentStatus   PaymentStatus  @default(unpaid) @map("payment_status")
  paymentDueAt    DateTime?      @map("payment_due_at")
  paidAt          DateTime?      @map("paid_at")
  shippingAddress Json           @map("shipping_address") // salinan alamat saat checkout
  shippingMethod  ShippingMethod @map("shipping_method")
  trackingNumber  String?        @map("tracking_number") @db.VarChar(50)
  promoCode       String?        @map("promo_code") @db.VarChar(30) // salinan kode, bukan FK
  notes           String?        @db.Text
  cancelReason    String?        @map("cancel_reason") @db.VarChar(255)
  shippedAt       DateTime?      @map("shipped_at")
  deliveredAt     DateTime?      @map("delivered_at")
  cancelledAt     DateTime?      @map("cancelled_at")
  createdAt       DateTime       @default(now()) @map("created_at")

  // Payment gateway Midtrans (OPEN_DECISIONS D9, runbooks/payment-midtrans.md §4a)
  paymentAttempt       Int     @default(0) @map("payment_attempt")
  paymentTransactionId String? @map("payment_transaction_id") @db.VarChar(64)
  paymentUrl           String? @map("payment_url") @db.VarChar(255)
  paymentType          String? @map("payment_type") @db.VarChar(32)

  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  items      OrderItem[]
  statusLogs OrderStatusLog[]
  promoUsage PromoUsage?

  @@index([userId])
  @@index([status])
  @@index([paymentDueAt])
  @@map("orders")
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int     @map("order_id")
  productId   Int     @map("product_id")
  variantId   Int?    @map("variant_id")
  name        String  @db.VarChar(200) // salinan saat checkout
  variantName String? @map("variant_name") @db.VarChar(50)
  image       String? @db.VarChar(255)
  price       Int
  weight      Int
  quantity    Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  review  Review?

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model OrderStatusLog {
  id          Int         @id @default(autoincrement())
  orderId     Int         @map("order_id")
  status      OrderStatus
  note        String?     @db.VarChar(255)
  changedById Int?        @map("changed_by") // NULL = sistem (cron, webhook)
  createdAt   DateTime    @default(now()) @map("created_at")

  order     Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([changedById])
  @@map("order_status_logs")
}

// ---------------------------------------------------------------------------
// Konten (1 tabel)

model Banner {
  id        Int     @id @default(autoincrement())
  title     String  @db.VarChar(150)
  subtitle  String? @db.VarChar(255)
  cta       String? @db.VarChar(50)
  href      String? @db.VarChar(255)
  image     String  @db.VarChar(255)
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  @@map("banners")
}
